# Copier en .env.local. Sans ces deux variables, le développement et les previews Netlify utilisent la base embarquée PGlite.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_…), publique par nature : la sécurité par ligne protège les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…), serveur seulement. Sur Netlify : contexte Production uniquement, jamais les previews.
SUPABASE_SECRET_KEY=
# Préversion branchée sur un projet Supabase de test (jamais celui de production) : 1 rouvre le code de connexion
# à l'écran et le paiement simulé. Interdite en production (le build échoue).
BASE_DE_TEST=
# E-mails : limite d'envoi de la boîte Infomaniak sur 24 heures (500 par défaut). À changer seulement après
# l'avoir fait relever chez Infomaniak. Les codes et les confirmations passent en dernier à la limite.
COURRIELS_PLAFOND_JOUR=
# 1 : « prête » et « en route » ne partent plus par e-mail (page de suivi seulement). Décision de Jérémy attendue.
COURRIELS_REDUITS=
